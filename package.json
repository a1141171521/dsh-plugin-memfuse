{
  "name": "dsh-memfuse",
  "version": "0.1.0",
  "description": "DSH 自动记忆系统：本地优先、文本可读、失败可见的分层记忆。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "long-term-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1141171521/dsh-plugin-memfuse.git"
  },
  "homepage": "https://github.com/a1141171521/dsh-plugin-memfuse#readme",
  "bugs": {
    "url": "https://github.com/a1141171521/dsh-plugin-memfuse/issues"
  },
  "scripts": {
    "test": "node --test test/plugin.test.mjs && node test/client.test.mjs && node test/preview.test.mjs && node test/smoke.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:plugin": "node --test test/plugin.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:preview": "node test/preview.test.mjs",
    "preview": "node docs/preview/serve.mjs",
    "demo": "node test/demo.mjs",
    "demo:suggest": "node test/demo-suggest.mjs",
    "smoke": "node .memfuse-smoke/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
